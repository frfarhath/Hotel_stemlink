{  
  "compilerOptions": {  
    "target": "es6",  
    "module": "commonjs",  
    "baseUrl": ".",  
    "paths": {  
      "@/*": ["src/*"]  
    },  
    "jsx": "react-jsx"  
  },  
  "include": [  
    "src/**/*"  
  ],  
  "exclude": [  
    "node_modules",  
    "**/*.spec.ts",  
    "**/*.test.ts"  
  ]  
}  